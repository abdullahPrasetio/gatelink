<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- WinExe = GUI subsystem: no black console window on Windows. Avalonia
         handles this correctly on macOS too. -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <RootNamespace>GateLink.Desktop</RootNamespace>
    <AssemblyName>GateLink</AssemblyName>
  </PropertyGroup>

  <!-- Request admin elevation only on Windows (for the Wintun/TAP adapter). -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' == 'win-x64' or $(DefineConstants.Contains('WINDOWS'))">
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <!-- Embed image assets, but not the shell script or the bundled binaries. -->
    <AvaloniaResource Include="Assets/**"
                      Exclude="Assets/hipreport.sh;Assets/openconnect/**" />
    <!-- Ship hipreport.sh as a loose file next to the exe. -->
    <Content Include="Assets/hipreport.sh">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>Assets/hipreport.sh</Link>
    </Content>
    <!-- Ship the bundled openconnect (binary + dylibs + vpnc-script) as loose
         files so the user doesn't need to install openconnect themselves. -->
    <Content Include="Assets/openconnect/**" Condition="Exists('Assets/openconnect')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>Assets/openconnect/%(RecursiveDir)%(Filename)%(Extension)</Link>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GateLink.Core\GateLink.Core.csproj" />
  </ItemGroup>

</Project>
