<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:GateLink.Desktop"
        x:Class="GateLink.Desktop.MainWindow"
        x:DataType="vm:MainViewModel"
        Width="380"
        Height="560"
        CanResize="False"
        Title="GateLink"
        Background="#2b2b2e"
        SystemDecorations="None"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        Topmost="True"
        CornerRadius="12">

    <Window.Resources>
        <!-- Clean eye icon (open) — replaces the emoji glyph -->
        <StreamGeometry x:Key="EyeIcon">M12,5 C5,5 1.5,12 1.5,12 C1.5,12 5,19 12,19 C19,19 22.5,12 22.5,12 C22.5,12 19,5 12,5 Z M12,15.5 A3.5,3.5 0 1 1 12,8.5 A3.5,3.5 0 0 1 12,15.5 Z</StreamGeometry>
        <!-- Eye off (slashed) -->
        <StreamGeometry x:Key="EyeOffIcon">M3,3 L21,21 M10.6,10.6 A3.5,3.5 0 0 0 13.4,13.4 M12,5 C19,5 22.5,12 22.5,12 C22.5,12 21.3,14.1 19.1,15.8 M6.5,7.3 C3.4,9.1 1.5,12 1.5,12 C1.5,12 5,19 12,19 C13.6,19 15,18.6 16.2,18</StreamGeometry>
    </Window.Resources>

    <Window.Styles>
        <!-- Small square icon button, content centred -->
        <Style Selector="Button.icon">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="6" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.icon:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#3a3a3d" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>
        <Style Selector="Button.link">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Foreground" Value="#0a84ff" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
        <Style Selector="TextBlock.label">
            <Setter Property="Foreground" Value="#c7c7cc" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <Style Selector="Border.field">
            <Setter Property="Background" Value="#3a3a3d" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="12,0" />
        </Style>
        <Style Selector="TextBox.plain">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#f2f2f7" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinHeight" Value="0" />
        </Style>
        <!-- transparent inner backgrounds so the field border shows through -->
        <Style Selector="TextBox.plain /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,Auto,Auto,Auto">

        <!-- ===== Header ===== -->
        <Border Grid.Row="0" Background="#343437" Padding="16,12" BorderBrush="#252527" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <!-- shield badge -->
                <Border Grid.Column="0" Width="26" Height="26" CornerRadius="7" Margin="0,0,10,0">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                            <GradientStop Color="#2dd4bf" Offset="0" />
                            <GradientStop Color="#0ea5e9" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Panel>
                        <Ellipse Width="10" Height="10" Stroke="White" StrokeThickness="2"
                                 HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-3,0,0" />
                        <Rectangle Width="3" Height="8" Fill="White" RadiusX="1.5" RadiusY="1.5"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,5,0,0" />
                    </Panel>
                </Border>
                <TextBlock Grid.Column="1" Text="GateLink" Foreground="#f2f2f7"
                           FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center" />
                <Button Grid.Column="2" Content="+" FontSize="20" Foreground="#c7c7cc"
                        Background="Transparent" BorderThickness="0" Padding="8,0"
                        Click="OnChooseQr" ToolTip.Tip="Add account" />
            </Grid>
        </Border>

        <!-- ===== Account row ===== -->
        <Border Grid.Row="1" Background="#2f2f32" Padding="16,14" BorderBrush="#252527" BorderThickness="0,0,0,1"
                IsVisible="{Binding HasAccount}">
            <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto">
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                    <TextBlock Text="{Binding Issuer}" Foreground="#f2f2f7" FontWeight="SemiBold" FontSize="14" />
                    <TextBlock Text="{Binding Account}" Foreground="#8e8e93" FontSize="12" />
                </StackPanel>

                <!-- reveal eye -->
                <Button Grid.Column="1" Classes="icon" Click="OnToggleReveal"
                        ToolTip.Tip="Reveal / hide code">
                    <PathIcon Data="{StaticResource EyeIcon}" Width="16" Height="16" Foreground="#c7c7cc" />
                </Button>

                <!-- OTP (masked or revealed) -->
                <TextBlock Grid.Column="2" Text="{Binding OtpMasked}" Foreground="#f2f2f7"
                           FontSize="15" FontFamily="Menlo,monospace" VerticalAlignment="Center"
                           Margin="4,0,10,0" />

                <!-- countdown ring -->
                <Border Grid.Column="3" Width="26" Height="26" CornerRadius="13"
                        BorderBrush="#0a84ff" BorderThickness="2" VerticalAlignment="Center">
                    <TextBlock Text="{Binding SecondsRemaining}" Foreground="#0a84ff" FontSize="10"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <!-- overflow menu -->
                <Button Grid.Column="4" Content="&#8230;" FontSize="16" Foreground="#c7c7cc"
                        Background="Transparent" BorderThickness="0" Padding="8,0"
                        VerticalAlignment="Center" ToolTip.Tip="More">
                    <Button.Flyout>
                        <MenuFlyout>
                            <MenuItem Header="Copy code" Click="OnCopy" />
                            <MenuItem Header="Account details" Click="OnShowDetails" />
                            <MenuItem Header="Check requirements" Click="OnCheckRequirements" />
                            <Separator />
                            <MenuItem Header="Delete account" Click="OnDeleteAccount" />
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
            </Grid>
        </Border>

        <!-- ===== Connection form ===== -->
        <StackPanel Grid.Row="2" Margin="16,14" Spacing="6">

            <!-- Status line, coloured by phase (green connected / grey idle / blue busy) -->
            <TextBlock Text="{Binding StatusLine}"
                       Foreground="{Binding StatusColor}"
                       FontWeight="SemiBold" FontSize="13" Margin="0,0,0,8"
                       IsVisible="{Binding HasAccount}" />

            <!-- Credential fields are hidden once connected, like the reference
                 client — only status + Disconnect remain. -->
            <StackPanel Spacing="6" IsVisible="{Binding ShowForm}">
                <TextBlock Text="Portal" Classes="label" />
                <Border Classes="field">
                    <TextBox Classes="plain" Text="{Binding Gateway, Mode=TwoWay}"
                             PlaceholderText="Portal hostname" />
                </Border>

                <TextBlock Text="Username" Classes="label" Margin="0,12,0,4" />
                <Border Classes="field">
                    <TextBox Classes="plain" Text="{Binding Username}" />
                </Border>

                <TextBlock Text="Password" Classes="label" Margin="0,12,0,4" />
                <Border Classes="field">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBox Grid.Column="0" x:Name="PasswordBox" Classes="plain"
                                 Text="{Binding Password}"
                                 PasswordChar="{Binding PasswordChar}"
                                 RevealPassword="{Binding PasswordRevealed}" />
                        <Button Grid.Column="1" Classes="icon" Click="OnTogglePassword"
                                ToolTip.Tip="Show / hide password">
                            <PathIcon Data="{StaticResource EyeIcon}" Width="16" Height="16" Foreground="#c7c7cc" />
                        </Button>
                    </Grid>
                </Border>
                <Button Classes="link" Content="Fill saved password" Margin="0,4,0,0"
                        Click="OnFillPassword"
                        ToolTip.Tip="Load the password stored in the encrypted vault" />
            </StackPanel>

            <Button Click="OnConnect" Margin="0,18,0,0" Height="44" CornerRadius="10"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                    Background="{Binding ConnectButtonColor}" Foreground="White" FontWeight="Bold" FontSize="15">
                <StackPanel Orientation="Horizontal" Spacing="6"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                    <PathIcon Data="M13,2 L4,14 L11,14 L10,22 L19,10 L12,10 Z"
                              Width="14" Height="14" Foreground="White" />
                    <TextBlock Text="{Binding ButtonText}" VerticalAlignment="Center" />
                </StackPanel>
            </Button>

            <!-- Status / error message wraps below the button instead of being
                 truncated inside it. -->
            <TextBlock Text="{Binding StatusText}" Foreground="#ff9f0a" FontSize="12"
                       TextWrapping="Wrap" Margin="2,2,2,0"
                       IsVisible="{Binding HasStatusMessage}" />
            <TextBlock Text="{Binding AddMessage}" Foreground="#38bdf8" FontSize="12"
                       TextWrapping="Wrap" Margin="2,0" />
        </StackPanel>

        <!-- ===== Footer ===== -->
        <Border Grid.Row="3" Background="#2a2a2d" Padding="16,10" BorderBrush="#252527" BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                <!-- Version (shown when up to date) -->
                <TextBlock Grid.Column="0" Text="{Binding VersionText}" Foreground="#6b7280"
                           FontSize="12" VerticalAlignment="Center"
                           IsVisible="{Binding !UpdateAvailable}" />
                <!-- New-update button (shown when an update exists) -->
                <Button Grid.Column="0" Content="{Binding UpdateText}" Click="OnInstallUpdate"
                        IsVisible="{Binding UpdateAvailable}"
                        Background="Transparent" BorderThickness="0" Padding="0"
                        Foreground="#ff9f0a" FontSize="12" FontWeight="SemiBold"
                        Cursor="Hand" VerticalAlignment="Center"
                        ToolTip.Tip="Click to download and install the update" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="0,0,12,0">
                    <CheckBox IsChecked="{Binding OpenAtLogin, Mode=TwoWay}" />
                    <TextBlock Text="Open at Login" Foreground="#c7c7cc" FontSize="12" VerticalAlignment="Center" />
                </StackPanel>
                <Button Grid.Column="3" Content="Quit" Background="Transparent" BorderThickness="0"
                        Foreground="#c7c7cc" FontSize="12" Click="OnQuit" />
            </Grid>
        </Border>
    </Grid>
</Window>
