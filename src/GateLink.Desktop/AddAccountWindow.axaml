<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="GateLink.Desktop.AddAccountWindow"
        Width="400" Height="420"
        CanResize="False"
        Title="Add account"
        Background="#2b2b2e"
        WindowStartupLocation="CenterScreen">

    <Window.Styles>
        <Style Selector="TextBlock.label">
            <Setter Property="Foreground" Value="#c7c7cc" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="#0a84ff" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Height" Value="42" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
    </Window.Styles>

    <StackPanel Margin="24" Spacing="12">
        <TextBlock Text="Add 2FA account" Foreground="#f2f2f7" FontWeight="Bold" FontSize="17" />

        <!-- QR option -->
        <TextBlock Text="From a QR image" Classes="label" Margin="0,8,0,0" />
        <Button Content="Choose QR image…" Click="OnChooseQr"
                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                Background="#3a3a3d" Foreground="#f2f2f7" CornerRadius="8" Height="40" />

        <Border Height="1" Background="#3a3a3d" Margin="0,8" />

        <!-- Manual option -->
        <TextBlock Text="Or enter manually" Classes="label" />
        <TextBlock Text="otpauth:// URI or Base32 secret" Foreground="#8e8e93" FontSize="11" />
        <TextBox x:Name="UriBox" PlaceholderText="otpauth://totp/… or JBSWY3DP…"
                 Background="#3a3a3d" Foreground="#f2f2f7" BorderBrush="#4a4a4d"
                 CornerRadius="8" Height="38" />

        <TextBlock Text="Label (optional, for manual secret)" Classes="label" Margin="0,4,0,0" />
        <TextBox x:Name="LabelBox" PlaceholderText="BRI VPN"
                 Background="#3a3a3d" Foreground="#f2f2f7" BorderBrush="#4a4a4d"
                 CornerRadius="8" Height="38" />

        <TextBlock x:Name="MessageText" Foreground="#ff9f0a" FontSize="12" TextWrapping="Wrap" />

        <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,8,0,0">
            <Button Grid.Column="0" Content="Cancel" Click="OnCancel"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                    Background="#3a3a3d" Foreground="#f2f2f7" CornerRadius="10" Height="42" />
            <Button Grid.Column="1" Classes="primary" Content="Add" Click="OnAdd" />
        </Grid>
    </StackPanel>
</Window>
