<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Platform-neutral: the core logic only uses System.Diagnostics.Process
         and System.IO, so it runs on Windows, macOS and Linux alike. -->
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>GateLink.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Cross-platform QR decoding: SkiaSharp loads the image to a pixel
         buffer, ZXing.Net decodes it. Both run on Windows and macOS. -->
    <PackageReference Include="ZXing.Net" Version="0.16.11" />
    <PackageReference Include="SkiaSharp" Version="4.153.1" />
  </ItemGroup>

</Project>
